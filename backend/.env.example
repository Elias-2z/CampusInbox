# Optional environment variable supplied by your launcher / shell.
# MinerU reads MINERU_API_KEY from backend/.env or the process environment.
# Copy this file to .env and fill the token locally. Never commit .env.
MINERU_API_KEY=
# Uploaded images and documents are sent to https://mineru.net only after confirmation.
# TXT / Markdown files are read locally without a token.
# CAMPUSINBOX_DB_PATH=/absolute/path/to/a/test.db
# Model settings are configured in the graphical Settings page and stored in SQLite.
